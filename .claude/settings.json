{
  "permissions": {
    "allow": [
      "Bash(yamllint *)",
      "Bash(packer validate *)",
      "Bash(packer fmt *)",
      "Bash(ansible-playbook --syntax-check *)",
      "Bash(ansible-playbook --check *)",
      "Bash(ansible-lint *)",
      "Bash(git *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-build-configure-scripts.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
